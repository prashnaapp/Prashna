# Local release signing configuration for Prashna Android.
# Copy this file to android/key.properties and fill in real values.
# NEVER commit android/key.properties, *.jks, or *.keystore.

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=YOUR_KEY_ALIAS
# Path is relative to the android/ directory (this file's folder).
storeFile=upload-keystore.jks
