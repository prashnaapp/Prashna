{
  "name": "prashna-firestore-rules-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Firestore Security Rules tests against the local Firebase Emulator. Loads ../../../../firestore.rules (repo root). Never connects to production.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "mocha --timeout 60000 \"./**/*.rules.test.mjs\"",
    "test:rules": "firebase emulators:exec --config ../../../firebase.json --only firestore --project prashna-rules-emulator \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.0.0",
    "mocha": "^11.0.0"
  }
}
