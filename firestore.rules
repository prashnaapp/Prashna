rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Existing users collection — ownership rules unchanged.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Cloud progress mirror — owner read/create/update only; no delete.
    match /user_progress/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Cloud bookmarks mirror — owner read/create/update only; no delete.
    match /user_bookmarks/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Cloud revision mirror — owner read/create/update only; no delete.
    match /user_revision/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
