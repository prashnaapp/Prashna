rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // SHARED HELPERS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function enrollmentDoc(courseId) {
      return get(/databases/$(database)/documents/user_courses/$(request.auth.uid)/courses/$(courseId));
    }

    function isCourseFree(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId))
        && courseDoc(courseId).data.isFree == true;
    }

    function hasActiveEnrollment(courseId) {
      return exists(/databases/$(database)/documents/user_courses/$(request.auth.uid)/courses/$(courseId))
        && enrollmentDoc(courseId).data.status == 'active'
        && (
          !('expiresAt' in enrollmentDoc(courseId).data)
          || enrollmentDoc(courseId).data.expiresAt == null
          || enrollmentDoc(courseId).data.expiresAt > request.time
        );
    }

    // Mirrors SubscriptionAccessService.canAccessCourse:
    // free course OR active non-expired enrollment for exact courseId.
    //
    // Paid entitlements must be written only by a trusted backend.
    // Clients cannot create/update enrollments (see user_courses rules).
    function canAccessCourse(courseId) {
      return isSignedIn()
        && (isCourseFree(courseId) || hasActiveEnrollment(courseId));
    }

    // Admin privilege comes ONLY from Firebase Auth custom claims.
    // Never authorize from users/{uid}.role, isAdmin, or any Firestore field.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }


    // ============================================================
    // USERS
    // ============================================================
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }


    // ============================================================
    // USER PROGRESS
    // ============================================================
    // Legacy parent: user_progress/{userId}
    // Per-course:     user_progress/{userId}/courses/{courseId}
    //
    // Phase 5.21: authoritative analytics (questionsAttempted/Correct and
    // related overall counters) are written only by Cloud Functions from
    // verified test attempts. Clients may read their own progress.
    match /user_progress/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update, delete: if false;

      match /courses/{courseId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete: if false;
      }

      // Phase 5.27: additive canonical unit performance from verified attempts.
      // Students may read only their own docs; clients cannot write.
      match /unit_performance/{scopeKey} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete: if false;
      }

      // Phase 5.29-1: student-controlled canonical syllabus completion.
      // Students may read only their own docs; mutations are server-only.
      match /syllabus_completion/{scopeKey} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete: if false;
      }
    }


    // ============================================================
    // USER BOOKMARKS
    // ============================================================
    match /user_bookmarks/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }


    // ============================================================
    // USER REVISION
    // ============================================================
    // Phase 5.21: wrong/frequent lists from verified tests are server-written.
    // Clients may read their own revision document only.
    match /user_revision/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update, delete: if false;
    }


    // ============================================================
    // COURSE CATALOG
    // ============================================================
    // Authenticated users can read published course information.
    // Clients cannot modify courses.
    match /courses/{courseId} {
      allow read: if request.auth != null;

      allow create, update: if false;
      allow delete: if false;
    }


    // ============================================================
    // USER COURSES / ENROLLMENTS
    // ============================================================
    //
    // Legacy document:
    // user_courses/{userId}
    //
    // New multi-course structure:
    // user_courses/{userId}/courses/{courseId}
    //
    // IMMEDIATE ENTITLEMENT LOCKDOWN:
    // Students may READ their own enrollments.
    // Students may NOT create or update enrollments.
    //
    // Free-course access does not require an enrollment document —
    // canAccessCourse allows courses/{courseId}.isFree == true.
    //
    // Paid entitlements must be granted only by a future trusted backend
    // (Admin SDK / Cloud Functions). Client-side free-enrollment writes are
    // also denied to avoid any entitlement-field spoofing surface.
    //
    // Migration consequence: client-side legacy → subcollection migration
    // writes are no longer possible; any remaining legacy-only docs need a
    // trusted server migration later.
    //
    match /user_courses/{userId} {

      // Legacy parent document
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update, delete: if false;


      // ----------------------------------------------------------
      // Individual course enrollment
      // ----------------------------------------------------------
      match /courses/{courseId} {

        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete: if false;
      }
    }


    // ============================================================
    // PAYMENT PLANS
    // ============================================================
    //
    // Users need to read plans so the subscription screen can show:
    //
    // Group-III
    //   30 Days  ₹149
    //   90 Days  ₹299
    //   365 Days ₹699
    //
    // Clients must NOT be able to create/change/delete plans.
    //
    match /payment_plans/{planId} {

      allow read: if request.auth != null;

      allow create, update, delete: if false;
    }


    // ============================================================
    // PAYMENT TRANSACTIONS
    // ============================================================
    //
    // IMMEDIATE ENTITLEMENT LOCKDOWN:
    // Students may read their own transactions.
    // Students may NOT create transactions (including status: success).
    // Trusted payment documents will be written only by a future backend.
    //
    match /payment_transactions/{transactionId} {

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create, update, delete: if false;
    }


    // ============================================================
    // QUESTIONS (Test Series bank)
    // ============================================================
    match /questions/{questionId} {
      // Entitled students: active questions for their course only.
      allow read: if isSignedIn()
        && resource.data.isActive == true
        && canAccessCourse(resource.data.courseId);

      // Admins: full read (including inactive) + CRUD.
      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // TESTS (Test Series definitions)
    // ============================================================
    match /tests/{testId} {
      // Entitled students: published tests for their course only.
      allow read: if isSignedIn()
        && resource.data.isPublished == true
        && canAccessCourse(resource.data.courseId);

      // Admins: full read (including unpublished) + CRUD.
      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // TEST ATTEMPTS
    // ============================================================
    //
    // Phase 5.20: authoritative attempts are written only by Admin SDK /
    // Cloud Functions (startTestAttempt / submitTestAttempt).
    // Students may read their own attempts (including legacy client-written
    // docs). Clients must not create or update score/result fields.
    //
    match /test_attempts/{attemptId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create, update, delete: if false;
    }

    // Server-only idempotency / side-effect markers for verified attempts.
    match /test_attempt_events/{attemptId} {
      allow read, create, update, delete: if false;
    }

    // Server-only answer-key / grading snapshots created at START TEST.
    // Students must never read correctOption from this collection.
    match /test_attempt_grading_snapshots/{attemptId} {
      allow read, create, update, delete: if false;
    }

    // Server-only start idempotency keys (uid__startRequestId).
    match /test_attempt_start_requests/{requestId} {
      allow read, create, update, delete: if false;
    }


    // ============================================================
    // DEFAULT
    // ============================================================
    //
    // Anything not explicitly allowed above is denied.
    //
  }
}
